# Environment Variables
# Set this file to .env and DO NOT commit .env to version control

# Database Configuration
# Turso (Production on Vercel)
# Get database URL: turso db show cashflow --url
# Get auth token: turso db tokens create cashflow
# Set these in the Vercel dashboard (Project Settings > Environment Variables)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# Or use local SQLite for development (default behavior)
# Leave both empty for local development with ./cashflow.db

# Server Configuration
# Vercel auto-injects PORT; no need to set it for deployments
PORT=8080

# CORS Configuration
# Set to your frontend URL(s) - supports comma-separated list for multiple origins
# Example: FRONTEND_URL=https://app.example.com,https://staging.example.com
# Default: http://localhost:5173 (if empty)
FRONTEND_URL=https://your-frontend.onrender.com
